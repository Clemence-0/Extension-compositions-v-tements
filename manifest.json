{
  "manifest_version": 3,
  "name": "Filtre Fibres",
  "version": "1.2.0",
  "description": "Masque les vêtements dont la part de fibres synthétiques dépasse ton seuil.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Filtre Fibres",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["parser.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
