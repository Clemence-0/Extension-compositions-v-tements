{
  "manifest_version": 3,
  "name": "Filtre Fibres",
  "version": "1.1.0",
  "description": "Masque les vêtements dont la part de fibres synthétiques dépasse ton seuil.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Filtre Fibres"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["parser.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
